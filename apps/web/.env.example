# Copy to .env.local and uncomment what you need.

# RPC per network. Without an override the app uses the SDK's default RPC
# (public testnet RPCs; local ports 8602 and 8604 for the two scenario forks).
# When public/deployments holds local-fork addresses for a live testnet, point
# that testnet at its fork:
# VITE_RPC_ARBITRUM_SEPOLIA=http://127.0.0.1:8601
# VITE_RPC_ROBINHOOD_TESTNET=http://127.0.0.1:8603
# VITE_RPC_KELP_REPLAY=http://127.0.0.1:8602
# VITE_RPC_EARN_BANK_RUN=http://127.0.0.1:8604

# Exeunt backend (capacity history, alerts, demo faucet).
# VITE_API_URL=http://127.0.0.1:8787
